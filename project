#include <stdio.h>

int main(void)
{
    int answer;
    int score = 0;

    printf("====================================\n");
    printf("       WELCOME TO QUIZ GAME\n");
    printf("====================================\n");

    printf("\nQ1. Who developed the C language?\n");
    printf("1. James Gosling\n");
    printf("2. Dennis Ritchie\n");
    printf("3. Guido van Rossum\n");
    printf("4. Bjarne Stroustrup\n");
    printf("Enter your answer (1-4): ");

    if (scanf("%d", &answer) != 1)
    {
        printf("Invalid input!\n");
        return 1;
    }

    if (answer == 2)
    {
        printf("Correct answer!\n");
        score++;
    }
    else
    {
        printf("Wrong answer! Correct answer is Dennis Ritchie.\n");
    }

    printf("\nQ2. Which symbol ends most C statements?\n");
    printf("1. .\n");
    printf("2. :\n");
    printf("3. ;\n");
    printf("4. ,\n");

    if (scanf("%d", &answer) != 1)
    {
        printf("Invalid input!\n");
        return 1;
    }

    if (answer == 3)
    {
        printf("Correct answer!\n");
        score++;
    }
    else
    {
        printf("Wrong answer! Correct answer is ;\n");
    }

    printf("\nQ3. Which function displays output in C?\n");
    printf("1. scanf()\n");
    printf("2. printf()\n");
    printf("3. input()\n");

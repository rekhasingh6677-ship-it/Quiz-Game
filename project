    if (scanf("%d", &answer) != 1)
    {
        printf("Invalid input!\n");
        return 1;
    }

    if (answer == 2)
    {
        printf("Correct answer!\n");
        score++;
    }
    else
    {
        printf("Wrong answer! Correct answer is printf().\n");
    }

    printf("\n====================================\n");
    printf("           QUIZ RESULT\n");
    printf("====================================\n");

    printf("Your score: %d out of 3\n", score);
    printf("Percentage: %.2f%%\n", (score / 3.0) * 100);

    if (score == 3)
    {
        printf("Excellent! Perfect score!\n");
    }
    else if (score >= 2)
    {
        printf("Good job! Keep learning.\n");
    }
    else
    {
        printf("Keep practicing!\n");
    }

    printf("Thank you for playing!\n");

    return 0;
}
